# --- Server ---
PORT=3017
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
TLS_CERT_PATH=
TLS_KEY_PATH=
BODY_LIMIT=16384

# --- Storage ---
# This service's own records (not backed up by itself).
DB_PATH=./data/backup.db
DB_BACKUP_DIR=
# Backup files, one folder per source. Created owner-only (0700); files are 0600.
BACKUP_DIR=./data/backups
# Restores write here unless a live restore is requested.
RESTORE_DIR=./data/restores

# --- Sources: id=path, comma separated. Paths are the live SQLite files of other services on this host.
BACKUP_SOURCES=atc-auth=../atc-auth/data/auth.db,atc-content=../atc-content/data/content.db

# --- Schedule and retention ---
# Minutes between scheduled backups of each source; 0 = manual only.
BACKUP_INTERVAL_MIN=360
# Newest successful backups kept per source.
RETENTION_COUNT=14
# Successful backups older than this are deleted (the newest is always kept); 0 = no age limit.
RETENTION_DAYS=30
# How often the scheduler looks for due sources, ms.
TICK_MS=60000
# SQLite pages copied per backup step. A step restarts if another process writes in between, so keep it large.
PAGES_PER_STEP=100000

# --- Live restore: replacing a running service's database. Off unless you need it; stop that service first.
ALLOW_LIVE_RESTORE=false

# --- Callers: id:secret:role[:source+source], comma separated. Secrets >= 32 chars, unique. Generate: openssl rand -hex 32
# Roles: read (sources, backups, stats, metrics), admin (also run, download, verify, restore, delete).
BACKUP_API_KEYS=atc-console:REPLACE_WITH_64_HEX_CHARS:admin
RATE_LIMIT_MAX=600

# --- Off-host copies (optional): upload each successful backup to atc-media as a private file. Both or neither.
# atc-media must list application/vnd.sqlite3 in ALLOWED_TYPES.
MEDIA_URL=
MEDIA_API_KEY=
MEDIA_TIMEOUT_MS=120000

# --- Audit (optional): forward backup events to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=atc-backup:…:write
AUDIT_URL=
AUDIT_API_KEY=
